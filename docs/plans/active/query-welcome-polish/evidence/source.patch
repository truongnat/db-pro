+                            .size(SelectSize::Sm)
+                            .variant(variant)
+                            .show(ui);
+                        assert!((select.rect.height() - button.rect.height()).abs() < 0.1);
+                        assert!((select.rect.center().y - button.rect.center().y).abs() < 0.1);
+                    });
+                });
+            });
+        }
+    }
+}
