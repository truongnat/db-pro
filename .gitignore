# Rust
/target/
**/*.rs.bk

# Node — the legacy React/Vite frontend is archived under _archive/frontend/.
# Only its generated/installed artifacts are ignored; the source stays tracked.
_archive/frontend/dist/
_archive/frontend/.tanstack/
_archive/frontend/src/routeTree.gen.ts
node_modules
*.tsbuildinfo

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Env
.env
.env.*
coverage/
.qoder/
bun.lock

# Generated test fixtures (archived frontend; see _archive/frontend/scripts/generate-fixtures.mjs)
_archive/frontend/test/fixtures/schemas/*.json

# Local native runtime state
/.db-pro-data/

# Allow plan docs and agent instructions (overrides global gitignore)
!docs/
!docs/**
!AGENTS.md
